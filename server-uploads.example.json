{
  "servers": [
    {
      "name": "main",
      "protocol": "ftp",
      "host": "example.com",
      "port": 21,
      "user": "username",
      "password": "your-password"
    },
    {
      "name": "staging",
      "protocol": "sftp",
      "host": "staging.example.com",
      "port": 22,
      "user": "deploy",
      "password": "another-password",

      "//sql": [
        "Optional. Adding an 'sql' block shows a database button in this",
        "server's header that opens an SQL console running queries over SSH.",
        "Requires SSH access to the host and your public key installed there:",
        "  ssh-copy-id deploy@staging.example.com",
        "database, dbUser and dbPassword are required; without them no button",
        "is shown. dbHost is the database as seen from the server itself."
      ],
      "sql": {
        "database": "myapp",
        "dbUser": "myapp_user",
        "dbPassword": "db-password",
        "dbHost": "localhost",
        "sshUser": "deploy",
        "sshPort": 22
      }
    }
  ],
  "uploads": [
    {
      "name": "Theme → prod",
      "server": "main",
      "remoteDir": "/public_html/wp-content/themes/mytheme/",
      "items": ["./wp-content/themes/mytheme/"],
      "exclude": [
        "**/node_modules/**",
        "**/*.log",
        "**/.git/**"
      ],
      "onExists": "overwrite"
    },
    {
      "name": "Single file → prod",
      "server": "main",
      "remoteDir": "/public_html/",
      "items": ["./bundle/app.js"]
    },
    {
      "name": "Static site → staging",
      "server": "staging",
      "remoteDir": "/var/www/staging/",
      "items": ["./dist/"],
      "exclude": ["**/*.map"]
    },
    {
      "name": "Next.js export → prod (mirror: чистит старые билды)",
      "server": "main",
      "remoteDir": "/public_html/app/",
      "items": ["./out/"],
      "mode": "mirror",
      "protectRemote": [".htaccess", "api/**"]
    }
  ]
}
